<?xml version="1.0" encoding="utf-8"?>
<!-- 车机桌面：渲染在 VirtualDisplay 上（由 Presentation 挂载），滚动/点击等全部走标准 View 体系 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="CarPlay Sender"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="虚拟显示器 + Presentation 渲染，可直接用标准 View/滚动/手势"
        android:textColor="#9AB0C4"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnRed"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="56dp"
        android:backgroundTint="#E53935"
        android:text="红色按钮"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnGreen"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#43A047"
        android:text="绿色按钮"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnBlue"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E88E5"
        android:text="蓝色按钮"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_weight="1"
        android:background="#161C22">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="▼ 可滚动区域：车机上滑动试试\n"
            android:textColor="#7EE3A0"
            android:textSize="13sp" />
    </ScrollView>

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:textColor="#9AB0C4"
        android:textSize="13sp" />
</LinearLayout>
